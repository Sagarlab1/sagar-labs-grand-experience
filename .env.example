# Production canonical origin, without trailing slash.
SITE_URL=https://www.sagarlabs.com
# Same-origin form submissions; comma-separated exact HTTPS origins.
ALLOWED_ORIGINS=https://www.sagarlabs.com,https://sagarlabs.com
# Durable reception for Vercel. Configure through server-side environment settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random secret used to hash rate-limit identifiers.
ENQUIRY_HASH_SALT=
